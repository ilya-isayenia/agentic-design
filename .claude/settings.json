{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(node tools/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git mv*)",
      "Bash(git push -u origin*)",
      "Bash(gh pr create*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)"
    ],
    "deny": [
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "Edit(/AGENTS.md)",
      "Write(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Write(/CLAUDE.md)",
      "Edit(/.github/**)",
      "Write(/.github/**)",
      "Edit(/tests/visual/baselines/**)",
      "Write(/tests/visual/baselines/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)"
    ]
  }
}
