{
  "name": "agentic-design",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "tokens": "pnpm --filter @agentic/tokens build",
    "dev": "pnpm tokens && pnpm --filter @agentic/web dev",
    "build": "pnpm tokens && pnpm --filter @agentic/web build",
    "storybook": "pnpm tokens && storybook dev -p 6006",
    "build-storybook": "pnpm tokens && storybook build -o storybook-static --quiet",
    "typecheck": "pnpm tokens && vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:storybook": "pnpm tokens && vitest run --project storybook",
    "contrast": "pnpm tokens && node tools/contrast/index.mjs",
    "test:visual": "node tools/visual/run.mjs",
    "test:visual:update": "node tools/visual/run.mjs --update",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "denylist": "node tools/denylist/index.mjs",
    "shots": "node tools/shots/index.mjs",
    "evidence": "node tools/evidence/index.mjs",
    "check": "node tools/check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/vue3-vite": "10.6.6",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "playwright": "1.65.0",
    "storybook": "10.6.6",
    "style-dictionary": "5.8.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
